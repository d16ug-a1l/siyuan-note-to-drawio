{
  "name": "siyuan-note-to-drawio",
  "version": "0.3.0",
  "description": "One-click conversion of the current SiYuan note into a draw.io flowchart generated by a cloud LLM",
  "main": "./src/index.js",
  "scripts": {
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "deploy": "node scripts/deploy.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "siyuan",
    "drawio",
    "flowchart",
    "llm",
    "ai"
  ],
  "author": "Lipeng",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  }
}
